    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": { "drizzle-orm": "^0.45.2", "postgres": "^3.4.5" },
  "devDependencies": { "drizzle-kit": "^0.31.0", "tsx": "^4.19.3", "typescript": "^7.0.2", "vitest": "^4.1.11" }
}
