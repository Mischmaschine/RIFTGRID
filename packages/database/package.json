    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": { "drizzle-orm": "^0.45.4", "postgres": "^4.0.0" },
  "devDependencies": { "drizzle-kit": "^0.31.11", "tsx": "^4.23.15", "typescript": "^7.0.2", "vitest": "^5.0.5" }
}
